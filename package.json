{
  "name": "hostyler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:verify": "tsx scripts/verify-phase1.ts",
    "db:integrity": "tsx scripts/verify-db-integrity.ts",
    "design:verify": "tsx scripts/verify-phase2.ts",
    "foundation:verify": "tsx scripts/verify-phase0.ts",
    "env:verify": "tsx scripts/verify-env.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "smoke": "tsx scripts/verify-local-smoke.ts",
    "verify:all": "tsx scripts/verify-all.ts",
    "audit": "pnpm audit",
    "dev": "next dev",
    "predev": "prisma generate && prisma migrate deploy",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@paypal/react-paypal-js": "^10.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "playwright": "1.62.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.0",
      "nodemailer": "^9.0.3",
      "minimatch": "^10.2.6"
    }
  }
}
