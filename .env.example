# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Database (matches docker-compose.yml local defaults)
DATABASE_URL=postgresql://hostyler:hostyler@localhost:5434/hostyler

# Auth.js
AUTH_SECRET=dev-local-auth-secret-change-in-production
AUTH_URL=http://localhost:3000

# SMTP (optional locally — emails log to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hostyler <hello@hostyler.dev>"
SMTP_TO=hello@hostyler.dev

# PayPal Sandbox — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Security & ops (local dev values — rotate for production)
CONTACT_RATE_LIMIT_PER_HOUR=5
HEALTH_CHECK_SECRET=dev-local-health-secret
CRON_SECRET=dev-local-cron-secret
INVOICE_PAY_TOKEN_SECRET=dev-local-invoice-pay-token-secret
INVOICE_DUE_DAYS_DEFAULT=14

# Seed users (development only — not used in production deploy)
SEED_ADMIN_EMAIL=support@hostyler.com
SEED_ADMIN_PASSWORD=Abbasisgreat123@
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=ChangeMeClient123!
