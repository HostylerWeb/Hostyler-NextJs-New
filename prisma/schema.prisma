generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum user_role {
  client
  admin
}

enum project_type {
  web
  app
  ai
  multiple
  unsure
}

enum budget_range {
  under_25k
  range_25_50k @map("25_50k")
  range_50_100k @map("50_100k")
  range_100k_plus @map("100k_plus")
  exploring
}

enum invoice_status {
  draft
  sent
  viewed
  partially_paid
  paid
  overdue
  cancelled
}

enum payment_provider {
  paypal
}

enum payment_status {
  pending
  completed
  failed
  refunded
}

enum ticket_status {
  open
  waiting_on_client
  waiting_on_staff
  resolved
  closed
}

enum ticket_priority {
  low
  normal
  high
  urgent
}

enum ticket_category {
  billing
  technical
  project
  other
}

enum ticket_reply_by {
  client
  staff
}

// ─── Auth (Auth.js Prisma adapter + credentials) ─────────────────────────────

model users {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamptz(6)
  password_hash     String    @db.VarChar(255)
  name              String    @db.VarChar(255)
  company           String?   @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  role              user_role @default(client)
  is_active         Boolean   @default(true)
  last_login_at     DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  accounts              accounts[]
  sessions              sessions[]
  contact_submissions   contact_submissions[]
  invoices_as_client    invoices[]            @relation("invoice_client")
  invoices_created      invoices[]            @relation("invoice_creator")
  invoice_status_logs   invoice_status_history[]
  payments              payments[]
  support_tickets       support_tickets[]     @relation("ticket_client")
  tickets_assigned      support_tickets[]     @relation("ticket_assignee")
  support_messages      support_messages[]
  password_reset_tokens password_reset_tokens[]

  @@map("users")
}

model accounts {
  id                  String  @id @default(uuid()) @db.Uuid
  user_id             String  @db.Uuid
  type                String  @db.VarChar(255)
  provider            String  @db.VarChar(255)
  provider_account_id String  @db.VarChar(255)
  refresh_token       String? @db.Text
  access_token        String? @db.Text
  expires_at          Int?
  token_type          String? @db.VarChar(255)
  scope               String? @db.VarChar(255)
  id_token            String? @db.Text
  session_state       String? @db.VarChar(255)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("accounts")
}

model sessions {
  id            String   @id @default(uuid()) @db.Uuid
  session_token String   @unique @db.VarChar(255)
  user_id       String   @db.Uuid
  expires       DateTime @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model verification_tokens {
  identifier String   @db.VarChar(255)
  token      String   @db.VarChar(255)
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model password_reset_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

model rate_limit_events {
  id         String   @id @default(uuid()) @db.Uuid
  bucket_key String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([bucket_key, created_at])
  @@map("rate_limit_events")
}

// ─── Marketing & contact ─────────────────────────────────────────────────────

model contact_submissions {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(255)
  email         String        @db.VarChar(255)
  project_type  project_type
  budget        budget_range
  message       String?       @db.Text
  ip_address    String?       @db.VarChar(45)
  user_agent    String?       @db.Text
  email_sent_at DateTime?     @db.Timestamptz(6)
  email_error   String?       @db.Text
  user_id       String?       @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  user users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([created_at])
  @@map("contact_submissions")
}

model case_studies {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique @db.VarChar(255)
  title           String    @db.VarChar(255)
  client_name     String    @db.VarChar(255)
  excerpt         String    @db.Text
  body            String    @db.Text
  cover_image_url String    @db.VarChar(500)
  tags            Json      @default("[]")
  stats           Json      @default("[]")
  featured        Boolean   @default(false)
  sort_order      Int       @default(0)
  published       Boolean   @default(false)
  published_at    DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([published, sort_order])
  @@map("case_studies")
}

// ─── Invoicing ───────────────────────────────────────────────────────────────

model invoices {
  id                    String         @id @default(uuid()) @db.Uuid
  invoice_number        String         @unique @db.VarChar(50)
  user_id               String         @db.Uuid
  status                invoice_status @default(draft)
  currency              String         @default("USD") @db.VarChar(3)
  subtotal              Decimal        @db.Decimal(12, 2)
  tax_rate              Decimal        @default(0) @db.Decimal(5, 2)
  tax_amount            Decimal        @default(0) @db.Decimal(12, 2)
  total                 Decimal        @db.Decimal(12, 2)
  amount_paid           Decimal        @default(0) @db.Decimal(12, 2)
  issue_date            DateTime       @db.Date
  due_date              DateTime       @db.Date
  paid_at               DateTime?      @db.Timestamptz(6)
  notes                 String?        @db.Text
  client_notes          String?        @db.Text
  pay_token             String?        @unique @db.VarChar(255)
  pay_token_expires_at  DateTime?      @db.Timestamptz(6)
  sent_at               DateTime?      @db.Timestamptz(6)
  last_reminder_at      DateTime?      @db.Timestamptz(6)
  created_by_id         String         @db.Uuid
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime       @updatedAt @db.Timestamptz(6)

  client    users  @relation("invoice_client", fields: [user_id], references: [id])
  created_by users @relation("invoice_creator", fields: [created_by_id], references: [id])
  line_items invoice_line_items[]
  status_history invoice_status_history[]
  payments  payments[]

  @@index([user_id])
  @@index([status])
  @@index([due_date])
  @@map("invoices")
}

model invoice_line_items {
  id          String  @id @default(uuid()) @db.Uuid
  invoice_id  String  @db.Uuid
  description String  @db.VarChar(500)
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sort_order  Int     @default(0)

  invoice invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@map("invoice_line_items")
}

model invoice_status_history {
  id            String          @id @default(uuid()) @db.Uuid
  invoice_id    String          @db.Uuid
  from_status   invoice_status?
  to_status     invoice_status
  changed_by_id String?         @db.Uuid
  note          String?         @db.Text
  created_at    DateTime        @default(now()) @db.Timestamptz(6)

  invoice    invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  changed_by users?   @relation(fields: [changed_by_id], references: [id], onDelete: SetNull)

  @@index([invoice_id])
  @@map("invoice_status_history")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model payments {
  id                  String           @id @default(uuid()) @db.Uuid
  invoice_id          String           @db.Uuid
  user_id             String?          @db.Uuid
  provider            payment_provider @default(paypal)
  provider_order_id   String           @unique @db.VarChar(255)
  provider_capture_id String?          @db.VarChar(255)
  status              payment_status   @default(pending)
  amount              Decimal          @db.Decimal(12, 2)
  currency            String           @db.VarChar(3)
  payer_email         String?          @db.VarChar(255)
  raw_response        Json?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @updatedAt @db.Timestamptz(6)

  invoice invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  user    users?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([invoice_id])
  @@index([status])
  @@map("payments")
}

// ─── Support ─────────────────────────────────────────────────────────────────

model support_tickets {
  id              String          @id @default(uuid()) @db.Uuid
  ticket_number   String          @unique @db.VarChar(50)
  user_id         String          @db.Uuid
  assigned_to_id  String?         @db.Uuid
  subject         String          @db.VarChar(500)
  status          ticket_status   @default(open)
  priority        ticket_priority @default(normal)
  category        ticket_category @default(technical)
  last_reply_at   DateTime        @default(now()) @db.Timestamptz(6)
  last_reply_by   ticket_reply_by @default(client)
  resolved_at     DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  client     users              @relation("ticket_client", fields: [user_id], references: [id])
  assigned_to users?            @relation("ticket_assignee", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  messages   support_messages[]

  @@index([user_id])
  @@index([status])
  @@index([assigned_to_id])
  @@map("support_tickets")
}

model support_messages {
  id          String   @id @default(uuid()) @db.Uuid
  ticket_id   String   @db.Uuid
  author_id   String   @db.Uuid
  body        String   @db.Text
  is_internal Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  ticket support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  author users           @relation(fields: [author_id], references: [id])

  @@index([ticket_id])
  @@map("support_messages")
}
